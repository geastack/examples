{
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geajs/core": "^1.5.1",
    "@geastack/core": "^0.1.30"
  },
  "devDependencies": {
    "@babel/parser": "latest",
    "@babel/traverse": "latest",
    "@babel/types": "latest",
    "@geajs/vite-plugin": "^1.5.0",
    "opentype.js": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "gea": {
    "id": "bouncing-balls-jsx",
    "name": "Balls JSX",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": {
        "build": {
          "ui": {
            "styleStorage": "shared"
          },
          "compiler": {
            "numberPrecision": "float32"
          },
          "renderer": {
            "subtreeRevealChecks": false,
            "recordInlinePositions": false,
            "fuseReplayFlush": true
          },
          "diagnostics": {
            "performanceCounters": false,
            "frameTiming": false
          },
          "display": {
            "presentStream": "continuous"
          }
        },
        "boards": {
          "esp32-s3-touch-amoled-1.8": {
            "build": {
              "compiler": {
                "generatedCodeOptimization": "O2"
              },
              "renderer": {
                "adaptiveCoalescing": true,
                "broadDirtyBounds": true
              },
              "display": {
                "framebufferStream": "continuous"
              }
            }
          },
          "esp32-s3-touch-amoled-2.41": {
            "build": {
              "display": {
                "presentStream": "independent"
              }
            }
          },
          "esp32-s3-lilygo-t-display-s3-long": {
            "build": {
              "renderer": {
                "fuseReplayFlush": false
              }
            }
          }
        }
      },
      "rp2350": true,
      "geaos": true
    },
    "icons": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    },
    "launcher": {
      "description": "animation test",
      "order": 6,
      "accent": "#22d3ee",
      "hidden": false
    }
  },
  "name": "@geastack/example-bouncing-balls-jsx",
  "type": "module",
  "private": true,
  "license": "MIT",
  "version": "0.1.0"
}
