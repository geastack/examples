{
  "name": "@geastack/example-css-blur-lab",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geajs/core": "^1.3.0",
    "@geastack/core": "^0.1.23"
  },
  "devDependencies": {
    "@babel/parser": "latest",
    "@babel/traverse": "latest",
    "@babel/types": "latest",
    "@geajs/core": "^1.3.0",
    "@geajs/vite-plugin": "^1.4.1",
    "opentype.js": "^1.3.4",
    "typescript": "latest",
    "vite": "latest"
  },
  "gea": {
    "id": "css-blur-lab",
    "name": "CSS Blur Lab",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "geaos": true
    },
    "launcher": {
      "description": "CSS filter blur alpha test",
      "order": 24,
      "accent": "#8ce8c4",
      "hidden": true
    }
  },
  "private": true,
  "license": "MIT",
  "version": "0.1.0"
}
