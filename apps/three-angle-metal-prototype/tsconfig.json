{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "noEmit": true
  },
  "include": ["index.tsx", "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["vite.config.ts"]
}
