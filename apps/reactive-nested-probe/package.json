{
  "name": "@geastack/example-reactive-nested-probe",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geajs/core": "^1.4.2",
    "@geastack/core": "^0.1.23"
  },
  "devDependencies": {
    "@babel/parser": "latest",
    "@babel/traverse": "latest",
    "@babel/types": "latest",
    "@geajs/vite-plugin": "^1.4.2",
    "opentype.js": "^1.3.4",
    "typescript": "latest",
    "vite": "latest"
  },
  "gea": {
    "id": "reactive-nested-probe",
    "name": "Reactive Nested Probe",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true
    },
    "launcher": {
      "description": "experimental: ReactiveComponent mounting a store-param child and a reactive child",
      "order": 999,
      "accent": "#22d3ee",
      "hidden": true
    }
  },
  "private": true,
  "license": "MIT",
  "version": "0.1.0"
}
