{
  "name": "@geastack/example-notes-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geastack/apple": "^0.2.8"
