{
  "name": "@geastack/example-gea3d-cube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geajs/core": "^1.3.0",
    "@geastack/core": "^0.1.23"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "vite": "8.0.8"
  },
  "gea": {
    "id": "gea3d-cube",
    "name": "Gea3D Cube",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "geaos": true,
      "rp2350": true
    },
    "nativeSources": [
      "src/gea3d/native/gea3d_native.cpp"
    ],
    "icons": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    },
    "launcher": {
      "description": "Gea-native software 3D renderer demo",
      "order": 19,
      "accent": "#5eead4",
      "hidden": false
    }
  },
  "license": "MIT"
}
