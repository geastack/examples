{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "jsx": "preserve"
  },
  "include": [
    "**/*.tsx",
    "**/*.ts",
    "**/*.d.ts",
    "../../node_modules/@geajs/vite-plugin/gea-env.d.ts"
  ],
  "exclude": [
    "vite.config.ts",
    "test"
  ]
}
