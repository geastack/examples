{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "flash": "gea flash",
    "flash:monitor": "gea flash --monitor",
    "ota": "gea ota",
    "ota:monitor": "gea ota --monitor",
    "monitor": "gea monitor",
    "test": "vitest run"
  },
  "dependencies": {
    "@geajs/core": "^1.4.2",
    "@geastack/core": "^0.1.24"
  },
  "devDependencies": {
    "@geajs/vite-plugin": "^1.4.2",
    "@geastack/cli": "^0.1.78",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "gea": {
    "id": "sky-hop",
    "name": "Sky Hop Canvas",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "android": true,
      "geaos": true
    },
    "icons": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    },
    "launcher": {
      "description": "canvas game",
      "order": 19,
      "accent": "#34d399",
      "hidden": false
    }
  },
  "name": "@geastack/example-sky-hop",
  "private": true,
  "license": "MIT",
  "version": "0.1.0"
}
