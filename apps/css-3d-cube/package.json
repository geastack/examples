{
  "name": "@geastack/example-css-3d-cube",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@geajs/core": "^1.4.2",
    "@geastack/core": "^0.1.40"
  },
  "devDependencies": {
    "@babel/parser": "latest",
    "@babel/traverse": "latest",
    "@babel/types": "latest",
    "@geajs/core": "^1.4.2",
    "@geajs/vite-plugin": "^1.4.2",
    "opentype.js": "^1.3.4",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest"
  },
  "gea": {
    "id": "css-3d-cube",
    "name": "CSS 3D Cube",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "geaos": true,
      "android": true,
      "rp2350": {
        "boards": {
          "rp2350-tufty-2350": {
            "cssDevicePixelRatio": 1
          }
        }
      }
    },
    "icons": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    },
    "launcher": {
      "description": "3D CSS demo",
      "order": 23,
      "accent": "#818cf8",
      "hidden": false
    }
  },
  "private": true,
  "license": "MIT",
  "version": "0.1.0"
}
