{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "flash": "gea flash",
    "flash:monitor": "gea flash --monitor",
    "ota": "gea ota",
    "ota:monitor": "gea ota --monitor",
    "monitor": "gea monitor"
  },
  "dependencies": {
    "@geajs/core": "^1.4.2",
    "@geastack/core": "^0.1.24"
  },
  "devDependencies": {
    "@geajs/vite-plugin": "^1.4.2",
    "@geastack/cli": "^0.1.78",
    "typescript": "6.0.2",
    "vite": "8.0.8"
  },
  "gea": {
    "id": "canvas-3d",
    "name": "Canvas 3D",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "geaos": true
    },
    "icons": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    },
    "launcher": {
      "description": "wireframe",
      "order": 18,
      "accent": "#818cf8",
      "hidden": false
    }
  },
  "name": "@geastack/example-canvas-3d",
  "private": true,
  "license": "MIT",
  "version": "0.1.0"
}
