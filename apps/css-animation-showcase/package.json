{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geajs/core": "^1.4.2",
    "@geastack/core": "^0.1.24"
  },
  "devDependencies": {
    "@babel/parser": "latest",
    "@babel/traverse": "latest",
    "@babel/types": "latest",
    "@geajs/vite-plugin": "^1.4.2",
    "opentype.js": "^1.3.4",
    "typescript": "latest",
    "vite": "latest"
  },
  "gea": {
    "id": "css-animation-showcase",
    "name": "CSS Animations",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "geaos": true
    },
    "icons": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    },
    "launcher": {
      "description": "gea::css demo",
      "order": 4,
      "accent": "#22d3ee",
      "hidden": false
    }
  },
  "name": "@geastack/example-css-animation-showcase",
  "private": true,
  "license": "MIT",
  "version": "0.1.0"
}
