{
  "name": "@geastack/example-diagnostics",
  "type": "module",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geajs/core": "^1.3.0",
    "@geastack/core": "^0.1.23"
  },
  "devDependencies": {
    "@geajs/vite-plugin": "^1.4.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "gea": {
    "id": "diagnostics",
    "name": "Diagnostics",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "geaos": true
    },
    "nativeSources": [
      "native/device_info.cpp"
    ],
    "icons": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    },
    "launcher": {
      "description": "hardware diagnostics",
      "order": 30,
      "accent": "#0ea5e9",
      "hidden": false
    }
  }
}
