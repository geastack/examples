{
  "name": "@geastack/example-three-tvos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geastack/native-webgl-angle": "^0.1.20",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@geastack/apple": "^0.2.22",
    "@geastack/cli": "^0.1.112",
    "@geastack/compiler": "^1.0.49",
    "@geastack/core": "^0.1.52",
    "@geastack/host": "^0.1.23",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.3"
  },
  "gea": {
    "id": "three-tvos",
    "name": "Three tvOS",
    "entry": "index.ts",
    "targets": {
      "tvos": {
        "build": {
          "compiler": {
            "moduleGraph": "compile"
          }
        }
      },
      "web": false,
      "esp32": false
    },
    "launcher": {
      "description": "Three.js on Apple TV through native WebGL backed by ANGLE/Metal",
      "hidden": true
    }
  },
  "license": "MIT"
}
