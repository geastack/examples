{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "flash": "gea flash",
    "flash:monitor": "gea flash --monitor",
    "ota": "gea ota",
    "ota:monitor": "gea ota --monitor",
    "monitor": "gea monitor"
  },
  "dependencies": {
    "@geajs/core": "^1.4.2",
    "@geastack/core": "^0.1.23"
  },
  "devDependencies": {
    "@geajs/vite-plugin": "^1.4.2",
    "@geastack/cli": "^0.1.78",
    "typescript": "6.0.2",
    "vite": "8.0.8"
  },
  "gea": {
    "id": "bubble-grid-jsx",
    "name": "Bubble Grid JSX",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "geaos": true
    },
    "launcher": {
      "description": "watchOS-style pannable div bubble grid with edge fisheye",
      "order": 22,
      "accent": "#34d399",
      "hidden": false
    }
  },
  "name": "@geastack/example-bubble-grid-jsx",
  "private": true,
  "license": "MIT",
  "version": "0.1.0"
}
